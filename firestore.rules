rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper validation functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidReport(data) {
      return data.title is string
        && data.description is string
        && data.category is string
        && data.latitude is string
        && data.longitude is string
        && (data.imageUrl is string || data.imageUrl == null)
        && (data.imageBase64 is string || data.imageBase64 == null)
        && (data.videoUrl is string || data.videoUrl == null)
        && (data.videoBase64 is string || data.videoBase64 == null)
        && data.isGenuine is bool
        && data.severity is string && (data.severity == 'Low' || data.severity == 'Medium' || data.severity == 'High' || data.severity == 'Critical')
        && data.issueType is string
        && data.recommendedAction is string
        && data.targetDepartment is string
        && data.status is string && (data.status == 'Open' || data.status == 'Verifying' || data.status == 'Resolved')
        && data.upvotes is int
        && (data.peerVerifications is int || data.peerVerifications == null)
        && (data.verifiedByCitizens is bool || data.verifiedByCitizens == null)
        && data.aiSummary is string
        && data.createdAt is string;
    }
    
    function isValidUser(data) {
      return data.name is string && data.name.size() <= 100
        && (data.points is number)
        && data.isPublic is bool
        && data.createdAt is string;
    }
    
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId && isValidUser(incoming());
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    
    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}
