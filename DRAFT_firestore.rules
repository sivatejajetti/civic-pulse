rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper validation functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidReport(data) {
      return data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.category is string && data.category.size() <= 100
        && data.latitude is string && data.latitude.size() <= 50
        && data.longitude is string && data.longitude.size() <= 50
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.isGenuine is bool
        && data.severity is string && (data.severity == 'Low' || data.severity == 'Medium' || data.severity == 'High' || data.severity == 'Critical')
        && data.issueType is string && data.issueType.size() <= 200
        && data.recommendedAction is string && data.recommendedAction.size() <= 1000
        && data.targetDepartment is string && data.targetDepartment.size() <= 200
        && data.status is string && (data.status == 'Open' || data.status == 'Verifying' || data.status == 'Resolved')
        && data.upvotes is int
        && data.aiSummary is string && data.aiSummary.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 50;
    }
    
    match /reports/{reportId} {
      allow read, get, list: if true;
      
      allow create: if isValidId(reportId) && isValidReport(incoming());
      
      allow update: if isValidId(reportId) && isValidReport(incoming()) && (
        // Action 1: Upvoting (only upvotes is modified)
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes'])) ||
        // Action 2: Status Dispatch (updating status, recommendedAction, targetDepartment, or general metadata fields by admin)
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'targetDepartment', 'recommendedAction', 'severity', 'issueType', 'aiSummary', 'upvotes']))
      );
      
      allow delete: if isValidId(reportId);
    }
  }
}
